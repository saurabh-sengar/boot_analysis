diff --git a/mm/mhp_boot_timing.h b/mm/mhp_boot_timing.h
new file mode 100644
index 000000000000..280089bbb8fe
--- /dev/null
+++ b/mm/mhp_boot_timing.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MM_MHP_BOOT_TIMING_H
+#define MM_MHP_BOOT_TIMING_H
+
+#include <linux/math64.h>
+#include <linux/printk.h>
+#include <linux/types.h>
+#include <asm/tsc.h>
+
+static inline void mhp_print_boot_time(const char *name, u64 ticks)
+{
+	u64 ms;
+	u32 remainder, fraction;
+
+	if (!tsc_khz) {
+		pr_err("MHP_TIMING Saurabh: %s: TSC frequency unavailable; ticks=%llu\n",
+		       name, (unsigned long long)ticks);
+		return;
+	}
+
+	ms = div_u64_rem(ticks, tsc_khz, &remainder);
+	fraction = div_u64((u64)remainder * 1000, tsc_khz);
+	pr_info("MHP_TIMING Saurabh: %s elapsed=%llu.%03u ms\n",
+		name, (unsigned long long)ms, fraction);
+}
+
+#endif
