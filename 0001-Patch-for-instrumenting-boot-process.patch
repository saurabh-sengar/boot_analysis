From 7b72e721e5fd241ea43fa90b4b20949bdb77c672 Mon Sep 17 00:00:00 2001
From: Saurabh Sengar <ssengar@linux.microsoft.com>
Date: Sat, 21 Nov 2026 16:38:21 +0530
Subject: [PATCH] Patch for instrumenting boot process

Signed-off-by: Saurabh Sengar <ssengar@linux.microsoft.com>
---
 arch/x86/kernel/setup.c |  46 ++++++++++++
 drivers/base/init.c     |  12 ++++
 drivers/pci/probe.c     |  10 ++-
 init/main.c             | 154 +++++++++++++++++++++++++++++++++++++++-
 mm/hugetlb.c            |  14 ++++
 mm/mhp_boot_timing.h    |  27 +++++++
 mm/mm_init.c            |  13 ++++
 7 files changed, 274 insertions(+), 2 deletions(-)
 create mode 100644 mm/mhp_boot_timing.h

diff --git a/arch/x86/kernel/setup.c b/arch/x86/kernel/setup.c
index cda6adb9f69c..24d34ffe790f 100644
--- a/arch/x86/kernel/setup.c
+++ b/arch/x86/kernel/setup.c
@@ -18,6 +18,7 @@
 #include <linux/initrd.h>
 #include <linux/iscsi_ibft.h>
 #include <linux/kexec_handover.h>
+#include <linux/math64.h>
 #include <linux/memblock.h>
 #include <linux/panic_notifier.h>
 #include <linux/pci.h>
@@ -57,6 +58,7 @@
 #include <asm/proto.h>
 #include <asm/realmode.h>
 #include <asm/thermal.h>
+#include <asm/tsc.h>
 #include <asm/unwind.h>
 #include <asm/vsyscall.h>
 
@@ -883,6 +885,9 @@ static void __init x86_report_nx(void)
  */
 void __init setup_arch(char **cmdline_p)
 {
+	u64 saurabh_start;
+	unsigned int saurabh_tsc_khz;
+
 #ifdef CONFIG_X86_32
 	memcpy(&boot_cpu_data, &new_cpu_data, sizeof(new_cpu_data));
 
@@ -1086,7 +1091,18 @@ void __init setup_arch(char **cmdline_p)
 
 	cleanup_highmap();
 
+	/* timekeeping_init() has not run; use the calibrated boot CPU TSC. */
+	saurabh_tsc_khz = tsc_khz;
+	if (!saurabh_tsc_khz)
+		pr_warn("Saurabh: early x86 memory/ACPI timings unavailable: TSC not calibrated\n");
+
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	e820__memblock_setup();
+	if (saurabh_tsc_khz)
+		pr_info("Saurabh: boot MEMORY e820__memblock_setup parent=setup_arch "
+			"elapsed_ms=%llu clock=tsc\n",
+			div_u64(rdtsc_ordered() - saurabh_start,
+				saurabh_tsc_khz));
 
 	/*
 	 * Needs to run after memblock setup because it needs the physical
@@ -1135,7 +1151,13 @@ void __init setup_arch(char **cmdline_p)
 	 */
 	x86_platform.realmode_reserve();
 
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	init_mem_mapping();
+	if (saurabh_tsc_khz)
+		pr_info("Saurabh: boot MEMORY init_mem_mapping parent=setup_arch "
+			"elapsed_ms=%llu clock=tsc\n",
+			div_u64(rdtsc_ordered() - saurabh_start,
+				saurabh_tsc_khz));
 
 	/*
 	 * init_mem_mapping() relies on the early IDT page fault handling.
@@ -1186,7 +1208,13 @@ void __init setup_arch(char **cmdline_p)
 
 	acpi_table_upgrade();
 	/* Look for ACPI tables and reserve memory occupied by them. */
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	acpi_boot_table_init();
+	if (saurabh_tsc_khz)
+		pr_info("Saurabh: boot ACPI acpi_boot_table_init parent=setup_arch "
+			"elapsed_ms=%llu clock=tsc\n",
+			div_u64(rdtsc_ordered() - saurabh_start,
+				saurabh_tsc_khz));
 
 	vsmp_init();
 
@@ -1195,12 +1223,24 @@ void __init setup_arch(char **cmdline_p)
 	early_platform_quirks();
 
 	/* Some platforms need the APIC registered for NUMA configuration */
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	early_acpi_boot_init();
+	if (saurabh_tsc_khz)
+		pr_info("Saurabh: boot ACPI early_acpi_boot_init parent=setup_arch "
+			"elapsed_ms=%llu clock=tsc\n",
+			div_u64(rdtsc_ordered() - saurabh_start,
+				saurabh_tsc_khz));
 	x86_init.mpparse.early_parse_smp_cfg();
 
 	x86_flattree_get_config();
 
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	initmem_init();
+	if (saurabh_tsc_khz)
+		pr_info("Saurabh: boot MEMORY initmem_init parent=setup_arch "
+			"elapsed_ms=%llu clock=tsc\n",
+			div_u64(rdtsc_ordered() - saurabh_start,
+				saurabh_tsc_khz));
 	dma_contiguous_reserve(max_pfn_mapped << PAGE_SHIFT);
 
 	/*
@@ -1238,7 +1278,13 @@ void __init setup_arch(char **cmdline_p)
 	 * Parse SMP configuration. Try ACPI first and then the platform
 	 * specific parser.
 	 */
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	acpi_boot_init();
+	if (saurabh_tsc_khz)
+		pr_info("Saurabh: boot ACPI acpi_boot_init parent=setup_arch "
+			"elapsed_ms=%llu clock=tsc\n",
+			div_u64(rdtsc_ordered() - saurabh_start,
+				saurabh_tsc_khz));
 	x86_init.mpparse.parse_smp_cfg();
 
 	/* Last opportunity to detect and map the local APIC */
diff --git a/drivers/base/init.c b/drivers/base/init.c
index af8014416c24..161532fd060a 100644
--- a/drivers/base/init.c
+++ b/drivers/base/init.c
@@ -8,6 +8,8 @@
 #include <linux/init.h>
 #include <linux/memory.h>
 #include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/sched/clock.h>
 #include <linux/backing-dev.h>
 
 #include "base.h"
@@ -20,6 +22,8 @@
  */
 void __init driver_init(void)
 {
+	u64 saurabh_start;
+
 	/* These are the core pieces */
 	bdi_init(&noop_backing_dev_info);
 	devtmpfs_init();
@@ -37,8 +41,16 @@ void __init driver_init(void)
 	software_node_init();
 	platform_bus_init();
 	auxiliary_bus_init();
+	saurabh_start = sched_clock();
 	memory_dev_init();
+	pr_info("Saurabh: boot MEMORY memory_dev_init parent=driver_init "
+		"elapsed_ms=%llu clock=sched_clock\n",
+		(sched_clock() - saurabh_start) / 1000000ULL);
 	node_dev_init();
+	saurabh_start = sched_clock();
 	cpu_dev_init();
+	pr_info("Saurabh: boot DEVICE_MODEL cpu_dev_init parent=driver_init "
+		"elapsed_ms=%llu clock=sched_clock\n",
+		(sched_clock() - saurabh_start) / 1000000ULL);
 	container_dev_init();
 }
diff --git a/drivers/pci/probe.c b/drivers/pci/probe.c
index 27008e2ea5af..5b7cc19b0252 100644
--- a/drivers/pci/probe.c
+++ b/drivers/pci/probe.c
@@ -23,6 +23,7 @@
 #include <linux/irqdomain.h>
 #include <linux/pm_runtime.h>
 #include <linux/bitfield.h>
+#include <linux/sched/clock.h>
 #include <trace/events/pci.h>
 #include "pci.h"
 
@@ -3206,7 +3207,14 @@ static unsigned int pci_scan_child_bus_extend(struct pci_bus *bus,
  */
 unsigned int pci_scan_child_bus(struct pci_bus *bus)
 {
-	return pci_scan_child_bus_extend(bus, 0);
+	u64 saurabh_start = sched_clock();
+	unsigned int max_bus;
+
+	max_bus = pci_scan_child_bus_extend(bus, 0);
+	pr_info("Saurabh: boot PCI pci_scan_child_bus bus=%s max_bus=%02x elapsed_ms=%llu clock=sched_clock\n",
+		dev_name(&bus->dev), max_bus,
+		(sched_clock() - saurabh_start) / 1000000ULL);
+	return max_bus;
 }
 EXPORT_SYMBOL_GPL(pci_scan_child_bus);
 
diff --git a/init/main.c b/init/main.c
index 31f2bf54976a..0d515c648d93 100644
--- a/init/main.c
+++ b/init/main.c
@@ -19,6 +19,7 @@
 #include <linux/proc_fs.h>
 #include <linux/binfmts.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/syscalls.h>
 #include <linux/stackprotector.h>
 #include <linux/string.h>
@@ -114,6 +115,9 @@
 #include <asm/setup.h>
 #include <asm/sections.h>
 #include <asm/cacheflush.h>
+#ifdef CONFIG_X86
+#include <asm/tsc.h>
+#endif
 
 #define CREATE_TRACE_POINTS
 #include <trace/events/initcall.h>
@@ -122,6 +126,23 @@
 
 static int kernel_init(void *);
 
+/* kernel_init() reads this after free_initmem(), so do not use __initdata. */
+static u64 saurabh_boot_start_tsc;
+static u64 saurabh_init_handoff_tsc;
+
+static void saurabh_print_tsc_time(const char *name, u64 ticks, unsigned int khz)
+{
+	if (khz)
+		pr_info("Saurabh: boot %s elapsed_ms=%llu clock=tsc\n",
+			name, div_u64(ticks, khz));
+}
+
+static void saurabh_print_sched_time(const char *name, u64 ns)
+{
+	pr_info("Saurabh: boot %s elapsed_ms=%llu clock=sched_clock\n",
+		name, ns / 1000000ULL);
+}
+
 /*
  * Debug helper: via this flag we know that we are in 'early bootup code'
  * where only the boot processor is running with IRQ disabled.  This means
@@ -988,7 +1009,11 @@ void start_kernel(void)
 {
 	char *command_line;
 	char *after_dashes;
+	u64 saurabh_start;
+	u64 saurabh_gap_start, saurabh_gap_end;
+	unsigned int saurabh_tsc_khz;
 
+	saurabh_boot_start_tsc = rdtsc_ordered();
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
 	debug_objects_early_init();
@@ -1006,8 +1031,22 @@ void start_kernel(void)
 	boot_cpu_init();
 	page_address_init();
 	pr_notice("%s", linux_banner);
+	saurabh_gap_start = rdtsc_ordered();
 	setup_arch(&command_line);
+	saurabh_gap_end = rdtsc_ordered();
+	saurabh_print_tsc_time("GAP pre_setup_arch",
+		saurabh_gap_start - saurabh_boot_start_tsc, tsc_khz);
+	saurabh_print_tsc_time("ARCH setup_arch",
+		saurabh_gap_end - saurabh_gap_start, tsc_khz);
+	/* Early memory work precedes timekeeping_init(). */
+	saurabh_tsc_khz = tsc_khz;
+	if (!saurabh_tsc_khz)
+		pr_warn("Saurabh: early core memory timings unavailable: TSC not calibrated\n");
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
 	mm_core_init_early();
+	saurabh_print_tsc_time("MEMORY mm_core_init_early",
+		rdtsc_ordered() - saurabh_start, saurabh_tsc_khz);
+	saurabh_gap_start = rdtsc_ordered();
 	/* Static keys and static calls are needed by LSMs */
 	jump_label_init();
 	static_call_init();
@@ -1015,7 +1054,10 @@ void start_kernel(void)
 	setup_boot_config();
 	setup_command_line(command_line);
 	setup_nr_cpu_ids();
+	saurabh_start = rdtsc_ordered();
 	setup_per_cpu_areas();
+	saurabh_print_tsc_time("DETAIL setup_per_cpu_areas parent=post_early_memory",
+		rdtsc_ordered() - saurabh_start, saurabh_tsc_khz);
 	smp_prepare_boot_cpu();	/* arch-specific boot-cpu hooks */
 	early_numa_node_init();
 	boot_cpu_hotplug_init();
@@ -1046,7 +1088,17 @@ void start_kernel(void)
 	vfs_caches_init_early();
 	sort_main_extable();
 	trap_init();
+	saurabh_print_tsc_time("EARLY_SETUP post_early_memory",
+		rdtsc_ordered() - saurabh_gap_start, saurabh_tsc_khz);
+#ifdef CONFIG_X86
+	saurabh_start = saurabh_tsc_khz ? rdtsc_ordered() : 0;
+#endif
 	mm_core_init();
+#ifdef CONFIG_X86
+	saurabh_print_tsc_time("MEMORY mm_core_init",
+		rdtsc_ordered() - saurabh_start, saurabh_tsc_khz);
+#endif
+	saurabh_gap_start = rdtsc_ordered();
 	maple_tree_init();
 	poking_init();
 	ftrace_init();
@@ -1149,7 +1201,11 @@ void start_kernel(void)
 #endif
 	setup_per_cpu_pageset();
 	numa_policy_init();
+	/* Avoid the initial jiffies clocksource when timing early boot. */
+	saurabh_start = sched_clock();
 	acpi_early_init();
+	saurabh_print_sched_time("ACPI acpi_early_init parent=post_mm_core_init",
+		sched_clock() - saurabh_start);
 	if (late_time_init)
 		late_time_init();
 	sched_clock_init();
@@ -1182,10 +1238,17 @@ void start_kernel(void)
 	taskstats_init_early();
 	delayacct_init();
 
+	saurabh_start = sched_clock();
 	acpi_subsystem_init();
+	saurabh_print_sched_time("ACPI acpi_subsystem_init parent=post_mm_core_init",
+		sched_clock() - saurabh_start);
 	arch_post_acpi_subsys_init();
 	kcsan_init();
 
+	saurabh_print_tsc_time("CORE_SETUP post_mm_core_init",
+		rdtsc_ordered() - saurabh_gap_start, tsc_khz);
+	saurabh_init_handoff_tsc = rdtsc_ordered();
+
 	/* Do the rest non-__init'ed, we're now alive */
 	rest_init();
 
@@ -1354,12 +1417,18 @@ int __init_or_module do_one_initcall(initcall_t fn)
 	int count = preempt_count();
 	char msgbuf[64];
 	int ret;
+	bool saurabh_boot = system_state < SYSTEM_RUNNING;
+	u64 saurabh_start = 0, saurabh_ticks = 0;
 
 	if (initcall_blacklisted(fn))
 		return -EPERM;
 
 	do_trace_initcall_start(fn);
+	if (saurabh_boot)
+		saurabh_start = rdtsc_ordered();
 	ret = fn();
+	if (saurabh_boot)
+		saurabh_ticks = rdtsc_ordered() - saurabh_start;
 	do_trace_initcall_finish(fn, ret);
 
 	msgbuf[0] = 0;
@@ -1375,6 +1444,11 @@ int __init_or_module do_one_initcall(initcall_t fn)
 	WARN(msgbuf[0], "initcall %pS returned with %s\n", fn, msgbuf);
 
 	add_latent_entropy();
+	/* Only report boot initcalls taking at least 10 ms. */
+	if (saurabh_boot && tsc_khz &&
+	    saurabh_ticks >= (u64)tsc_khz * 10)
+		pr_info("Saurabh: boot INITCALL fn=%pS elapsed_ms=%llu rc=%d clock=tsc\n",
+			fn, div_u64(saurabh_ticks, tsc_khz), ret);
 	return ret;
 }
 
@@ -1412,6 +1486,7 @@ static int __init ignore_unknown_bootoption(char *param, char *val,
 static void __init do_initcall_level(int level, char *command_line)
 {
 	initcall_entry_t *fn;
+	u64 saurabh_start = rdtsc_ordered();
 
 	parse_args(initcall_level_names[level],
 		   command_line, __start___param,
@@ -1422,6 +1497,10 @@ static void __init do_initcall_level(int level, char *command_line)
 	do_trace_initcall_level(initcall_level_names[level]);
 	for (fn = initcall_levels[level]; fn < initcall_levels[level+1]; fn++)
 		do_one_initcall(initcall_from_entry(fn));
+	if (tsc_khz)
+		pr_info("Saurabh: boot INITCALL_LEVEL level=%s parent=do_initcalls elapsed_ms=%llu clock=tsc\n",
+			initcall_level_names[level],
+			div_u64(rdtsc_ordered() - saurabh_start, tsc_khz));
 }
 
 static void __init do_initcalls(void)
@@ -1452,21 +1531,37 @@ static void __init do_initcalls(void)
  */
 static void __init do_basic_setup(void)
 {
+	u64 saurabh_start = rdtsc_ordered();
+
 	cpuset_init_smp();
 	ksysfs_init();
+	saurabh_print_tsc_time("BUILTIN_DETAIL framework_setup parent=do_basic_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
+	saurabh_start = rdtsc_ordered();
 	driver_init();
+	saurabh_print_tsc_time("BUILTIN_DETAIL driver_init parent=do_basic_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
+	saurabh_start = rdtsc_ordered();
 	init_irq_proc();
 	do_ctors();
+	saurabh_print_tsc_time("BUILTIN_DETAIL irq_proc_and_ctors parent=do_basic_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
+	saurabh_start = rdtsc_ordered();
 	do_initcalls();
+	saurabh_print_tsc_time("BUILTIN_DETAIL do_initcalls parent=do_basic_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
 }
 
 static void __init do_pre_smp_initcalls(void)
 {
 	initcall_entry_t *fn;
+	u64 saurabh_start = rdtsc_ordered();
 
 	do_trace_initcall_level("early");
 	for (fn = __initcall_start; fn < __initcall0_start; fn++)
 		do_one_initcall(initcall_from_entry(fn));
+	saurabh_print_tsc_time("INITCALL_LEVEL level=early parent=pre_smp_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
 }
 
 static int run_init_process(const char *init_filename)
@@ -1554,7 +1649,11 @@ void __weak free_initmem(void)
 static int __ref kernel_init(void *unused)
 {
 	int ret;
+	u64 saurabh_start = rdtsc_ordered();
 
+	saurabh_print_tsc_time("GAP init_thread_handoff",
+		saurabh_start - saurabh_init_handoff_tsc, tsc_khz);
+	saurabh_start = rdtsc_ordered();
 	init_userspace_fs();
 
 	/*
@@ -1562,10 +1661,16 @@ static int __ref kernel_init(void *unused)
 	 */
 	wait_for_completion(&kthreadd_done);
 
+	saurabh_print_tsc_time("GAP init_thread_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
 	kernel_init_freeable();
 	/* need to finish all async __init code before freeing the memory */
+	saurabh_start = rdtsc_ordered();
 	async_synchronize_full();
+	saurabh_print_tsc_time("GAP async_synchronize_full",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
 
+	saurabh_start = rdtsc_ordered();
 	system_state = SYSTEM_FREEING_INITMEM;
 	kprobe_free_init_mem();
 	ftrace_free_init_mem();
@@ -1587,10 +1692,26 @@ static int __ref kernel_init(void *unused)
 
 	do_sysctl_args();
 
+	saurabh_print_tsc_time("GAP initmem_cleanup_and_readonly",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
 	if (ramdisk_execute_command) {
+		saurabh_start = rdtsc_ordered();
 		ret = run_init_process(ramdisk_execute_command);
-		if (!ret)
+		if (!ret) {
+			u64 saurabh_end_tsc = rdtsc_ordered();
+
+			if (tsc_khz) {
+				saurabh_print_tsc_time("GAP init_exec",
+					saurabh_end_tsc - saurabh_start, tsc_khz);
+				pr_info("Saurabh: boot KERNEL_TOTAL start_kernel_to_init_exec path=%s elapsed_ms=%llu clock=tsc tsc_khz=%u\n",
+					ramdisk_execute_command,
+					div_u64(saurabh_end_tsc - saurabh_boot_start_tsc,
+						tsc_khz), tsc_khz);
+			} else
+				pr_err("Saurabh: boot KERNEL_TOTAL unavailable: TSC not calibrated; path=%s\n",
+					ramdisk_execute_command);
 			return 0;
+		}
 		pr_err("Failed to execute %s (error %d)\n",
 		       ramdisk_execute_command, ret);
 	}
@@ -1645,6 +1766,9 @@ void __init console_on_rootfs(void)
 
 static noinline void __init kernel_init_freeable(void)
 {
+	u64 saurabh_start;
+	u64 saurabh_tail_start;
+
 	/* Now the scheduler is fully set up and can do blocking allocations */
 	gfp_allowed_mask = __GFP_BITS_MASK;
 
@@ -1655,8 +1779,12 @@ static noinline void __init kernel_init_freeable(void)
 
 	rcu_assign_pointer(cad_pid, get_pid(task_pid(current)));
 
+	saurabh_start = sched_clock();
 	smp_prepare_cpus(setup_max_cpus);
+	saurabh_print_sched_time("SMP smp_prepare_cpus",
+		sched_clock() - saurabh_start);
 
+	saurabh_start = rdtsc_ordered();
 	workqueue_init();
 
 	init_mm_internals();
@@ -1664,19 +1792,41 @@ static noinline void __init kernel_init_freeable(void)
 	do_pre_smp_initcalls();
 	lockup_detector_init();
 
+	saurabh_print_tsc_time("GAP pre_smp_setup",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
+
+	saurabh_start = sched_clock();
 	smp_init();
+	saurabh_print_sched_time("SMP smp_init",
+		sched_clock() - saurabh_start);
+	saurabh_start = sched_clock();
 	sched_init_smp();
+	saurabh_print_sched_time("SMP sched_init_smp",
+		sched_clock() - saurabh_start);
 
+	saurabh_start = rdtsc_ordered();
 	workqueue_init_topology();
 	async_init();
 	padata_init();
+	saurabh_print_tsc_time("GAP post_smp_topology",
+		rdtsc_ordered() - saurabh_start, tsc_khz);
+	saurabh_start = sched_clock();
 	page_alloc_init_late();
+	saurabh_print_sched_time("MEMORY page_alloc_init_late",
+		sched_clock() - saurabh_start);
 
+	saurabh_start = sched_clock();
 	do_basic_setup();
+	saurabh_print_sched_time("BUILTIN_SETUP do_basic_setup",
+		sched_clock() - saurabh_start);
 
